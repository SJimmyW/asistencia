# Environment variables for asiste deployment

# Google Sheets Configuration
# Get your Sheet ID from the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEETS_ID=your_google_sheet_id_here

# Optional: API Key for Google Sheets (if using public access)
# GOOGLE_API_KEY=your_api_key_here

# Application Configuration
APP_ENV=production
TIMEZONE=America/Argentina/Cordoba
LOG_LEVEL=info

# Optional: Database/Storage (for future versions)
# DATABASE_URL=
# STORAGE_BUCKET=
